# --- YouCam (Perfect Corp) — server only ---
YOUCAM_API_KEY=
YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# --- Gemini vision model (free tier) for invitation extraction + outfit observations — server only ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Supabase (Postgres + private Storage) — server only ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supavisor pooler, transaction mode :6543) — server only
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=wearcheck-private

# --- App ---
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
CRON_SECRET=
# Hard caps on paid provider renders
RENDER_LIMIT_PER_SESSION=4
RENDER_LIMIT_GLOBAL_PER_DAY=60
